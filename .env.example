# The OKX spread desk's secrets. start.py copies this to .env on the
# first run; the Exchanges page writes the keys here for you, so you
# never have to edit this file by hand.

# The account named "okx" uses these three (Stat_Arb_W3's own names, so
# an existing .env keeps working). Other accounts get their own keys,
# named on their Exchanges row (OKX_API_KEY_<NAME> ...).
# Create the key on OKX: Profile > API, with Read and Trade - never
# Withdraw. A Demo trading key only works with Mode = Demo trading.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Telegram (optional): a bot from @BotFather, and the Telegram user ids
# allowed to use it (comma separated; anyone else is ignored).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Optional: the cap on a "market" (IOC) order, in bps from the touch.
# OKX_IOC_PROTECTION_BPS=20
