# Flask Configuration
FLASK_SECRET_KEY=change-me-to-a-long-random-secret-key
FLASK_DEBUG=false

# ─── SaaS Security ─────────────────────────────────────────────────────────
# 32-byte key for encrypting API keys at rest (Fernet).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, derived from FLASK_SECRET_KEY (less secure – set this for production!)
ENCRYPTION_KEY=

# ─── Stripe Billing ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── WebSocket Streaming ───────────────────────────────────────────────────
# Set to false to use REST polling instead of WebSocket for market data
USE_WEBSOCKET=true

# ─── Legacy single-user OKX keys (optional – users manage their own via UI) ─
# These are used only if no user-specific keys are configured.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_DEMO_MODE=true

# Binance API Credentials (legacy)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true

# Bybit API Credentials (legacy)
BYBIT_API_KEY=
BYBIT_SECRET_KEY=
BYBIT_TESTNET=true

# Database
DATABASE_PATH=trading.db
